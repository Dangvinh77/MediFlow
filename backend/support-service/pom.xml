<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mediflow</groupId><artifactId>mediflow-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version><relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>support-service</artifactId>
    <name>MediFlow Support Host</name>
    <description>Explicit composition of Report and Notification, with separate stores.</description>
    <properties><testcontainers.version>1.20.6</testcontainers.version></properties>
    <dependencies>
        <dependency>
            <groupId>com.mediflow</groupId><artifactId>report-service</artifactId>
            <version>${project.version}</version><classifier>lib</classifier>
        </dependency>
        <dependency>
            <groupId>com.mediflow</groupId><artifactId>notification-service</artifactId>
            <version>${project.version}</version><classifier>lib</classifier>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>rabbitmq</artifactId><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope>
        </dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    </plugins></build>
    <profiles><profile>
        <id>support-acceptance</id>
        <build><plugins><plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            <configuration><includes><include>**/SupportPackagedAcceptanceIT.java</include></includes></configuration>
        </plugin></plugins></build>
    </profile><profile>
        <id>six-service-acceptance</id>
        <build><plugins><plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            <configuration><includes><include>**/SixServiceOutpatientAcceptanceIT.java</include></includes></configuration>
        </plugin></plugins></build>
    </profile><profile>
        <id>historical-support-acceptance</id>
        <build><plugins><plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            <configuration><includes><include>**/HistoricalSupportCutoverIT.java</include></includes></configuration>
        </plugin></plugins></build>
    </profile></profiles>
</project>
