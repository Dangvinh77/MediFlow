classDiagram
 direction TB
 namespace Clinical {
  class Appointment {
   UUID appointmentId
   UUID patientId
   UUID doctorId
   UUID departmentId
   AppointmentStatus status
   checkIn(priceCode, at)
   startExam(clearanceId, overrideId, at)
   complete(at)
  }
  class MedicalRecord {
   UUID recordId
   UUID appointmentId
   MedicalRecordStatus status
   RecordDisposition disposition
  }
  class Diagnosis {
   UUID diagnosisId
   String diagnosisName
   String icdCode
  }
  class ClinicalLabOrder {
   UUID sourceOrderId
   UUID recordId
   UUID patientId
  }
  class ExamClearance {
   UUID clearanceId
   UUID appointmentId
   Instant expiresAt
  }
 }
 Appointment "0..1" --> "0..1" MedicalRecord : appointmentId
 MedicalRecord "1" *-- "0..*" Diagnosis
 ClinicalLabOrder ..> MedicalRecord : recordId
 ExamClearance ..> Appointment : appointmentId
