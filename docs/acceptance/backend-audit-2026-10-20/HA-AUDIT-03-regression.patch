+    @TestConfiguration(proxyBeanMethods = false)
+    static class ConcurrencyTestConfiguration {
+
+        @Bean
+        DeactivationRaceBarrier deactivationRaceBarrier() {
+            return new DeactivationRaceBarrier();
+        }
+
+        @Bean
+        @Primary
+        StaffRepository staffRepositoryWithDeactivationBarrier(
+                StaffRepositoryAdapter delegate,
+                DeactivationRaceBarrier barrier) {
+            return new StaffRepository() {
+                @Override
+                public boolean existsByDepartmentIdAndActiveTrue(UUID departmentId) {
+                    boolean hasActiveStaff = delegate.existsByDepartmentIdAndActiveTrue(
+                            departmentId);
+                    barrier.pauseAfterActiveStaffCheck(departmentId, hasActiveStaff);
+                    return hasActiveStaff;
+                }
+
+                @Override
+                public java.util.Optional<com.mediflow.organization.domain.model.Staff> findById(
+                        UUID staffId) {
+                    return delegate.findById(staffId);
+                }
+
+                @Override
+                public com.mediflow.organization.domain.model.Staff save(
+                        com.mediflow.organization.domain.model.Staff staff) {
+                    return delegate.save(staff);
+                }
+
+                @Override
+                public PageResult<com.mediflow.organization.domain.model.Staff> search(
+                        UUID departmentId,
+                        JobTitle jobTitle,
+                        PageQuery pageQuery) {
+                    return delegate.search(departmentId, jobTitle, pageQuery);
+                }
+            };
+        }
+    }
+
+    static class DeactivationRaceBarrier {
+
+        private volatile UUID targetDepartmentId;
+        private volatile CountDownLatch checked = new CountDownLatch(0);
+        private volatile CountDownLatch released = new CountDownLatch(0);
+
+        void arm(UUID departmentId) {
+            targetDepartmentId = departmentId;
+            checked = new CountDownLatch(1);
+            released = new CountDownLatch(1);
+        }
+
+        boolean awaitStaffCheck(Duration timeout) throws InterruptedException {
+            return checked.await(timeout.toMillis(), TimeUnit.MILLISECONDS);
+        }
+
+        void release() {
+            released.countDown();
+        }
+
+        void pauseAfterActiveStaffCheck(UUID departmentId, boolean hasActiveStaff) {
+            if (!departmentId.equals(targetDepartmentId) || hasActiveStaff) {
+                return;
+            }
+            checked.countDown();
+            try {
+                if (!released.await(15, TimeUnit.SECONDS)) {
+                    throw new AssertionError("test did not release deactivation barrier");
+                }
+            } catch (InterruptedException exception) {
+                Thread.currentThread().interrupt();
+                throw new AssertionError("deactivation barrier was interrupted", exception);
+            }
+        }
+    }
