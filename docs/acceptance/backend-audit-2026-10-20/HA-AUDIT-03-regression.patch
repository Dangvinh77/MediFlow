+                DepartmentType.CLINICAL,
+                "Building R");
+        deactivationRaceBarrier.arm(department.getDepartmentId());
+
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+        try {
+            Future<?> deactivation = executor.submit(() -> updateDepartmentUseCase.execute(
+                    department.getDepartmentId(),
+                    department.getDepartmentName(),
+                    department.getDepartmentType(),
+                    department.getLocation(),
+                    null,
+                    false));
+
+            assertThat(deactivationRaceBarrier.awaitStaffCheck(Duration.ofSeconds(15)))
+                    .as("deactivation must reach the active-staff check")
+                    .isTrue();
+
+            Future<?> creation = executor.submit(() -> createStaffUseCase.execute(
+                    "Concurrent Staff " + UUID.randomUUID().toString().substring(0, 8),
+                    department.getDepartmentId(),
+                    JobTitle.DOCTOR,
+                    "Race Test",
+                    "RACE-LIC-" + UUID.randomUUID(),
+                    "0901234567",
+                    "race-" + UUID.randomUUID() + "@example.test"));
+            creation.get(15, TimeUnit.SECONDS);
+
+            deactivationRaceBarrier.release();
+            deactivation.get(15, TimeUnit.SECONDS);
+        } finally {
+            deactivationRaceBarrier.release();
+            executor.shutdownNow();
+        }
+
+        boolean activeStaff = staffStore.existsByDepartmentIdAndActiveTrue(
+                department.getDepartmentId());
+        boolean activeDepartment = departmentRepository.findById(department.getDepartmentId())
+                .orElseThrow()
+                .isActive();
+
+        assertThat(activeDepartment || !activeStaff)
+                .as("an inactive department must not contain active staff")
+                .isTrue();
+    }
