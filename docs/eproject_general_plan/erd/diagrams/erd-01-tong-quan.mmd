flowchart LR
    subgraph ORG["organization / 8089"]
        DEPT["DEPARTMENT<br/>department_id"]
        STAFF["STAFF<br/>staff_id"]
        ACCOUNT["ACCOUNT<br/>account_id"]
        DEPT -->|ma_khoa FK| STAFF
        STAFF -->|truong_khoa FK| DEPT
        STAFF -->|staff_id FK| ACCOUNT
    end
    subgraph PAT["patient / 8081"]
        PATIENT["PATIENT<br/>patient_id"]
    end
    subgraph CLI["clinical / 8082"]
        APPT["APPOINTMENT<br/>appointment_id"]
        MRECORD["MEDICAL_RECORD<br/>record_id"]
        DIAG["DIAGNOSIS<br/>diagnosis_id"]
        APPT -->|appointment_id FK| MRECORD
        MRECORD -->|record_id FK| DIAG
    end
    subgraph LAB["lab / 8084"]
        LTEST["LAB_TEST<br/>test_id"]
        LRESULT["LAB_RESULT<br/>result_id"]
        LTEST -->|test_id FK| LRESULT
    end
    subgraph PHA["pharmacy / 8085"]
        DRUG["DRUG<br/>drug_id"]
        RX["PRESCRIPTION<br/>prescription_id"]
        RXLINE["PRESCRIPTION_LINE<br/>line_id"]
        DSLIP["DISPENSE_SLIP<br/>dispense_id"]
        RX -->|prescription_id FK| RXLINE
        DRUG -->|drug_id FK| RXLINE
        RX -->|prescription_id FK UNIQUE| DSLIP
    end
    subgraph BIL["billing / 8086"]
        FEE["FEE<br/>fee_id"]
        INV["INVOICE<br/>invoice_id"]
        INV -->|invoice_id FK| FEE
    end
    subgraph NOT["notification / 8087"]
        NOTIF["NOTIFICATION<br/>notification_id"]
    end
    subgraph REP["report / 8088"]
        DVR["DAILY_VISIT_REPORT"]
        MRR["MONTHLY_REVENUE_REPORT"]
        DST["DRUG_STATISTIC"]
    end

    %% cross-service logical refs (bare UUID)
    PATIENT -.->|patient_id| APPT & MRECORD & LTEST & RX & FEE & INV & NOTIF
    DEPT -.->|department_id| STAFF & APPT & MRECORD & LTEST & RX & FEE & DVR & MRR
    STAFF -.->|doctor_id| APPT & MRECORD & RX
    MRECORD -.->|record_id| LTEST & RX & FEE
    RX -.->|prescription_id| INV
    DSLIP -.->|dispense_id| INV
