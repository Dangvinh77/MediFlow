flowchart LR
    subgraph ORG["organization"]
        DEPT["DEPARTMENT<br/>department_id"]
        STAFF["STAFF<br/>department_id"]
        ACCOUNT["ACCOUNT<br/>staff_id"]
    end
    subgraph CLI["clinical"]
        APPT["APPOINTMENT<br/>department_id"]
        MRECORD["MEDICAL_RECORD<br/>department_id"]
    end
    subgraph LAB["lab"]
        LTEST["LAB_TEST<br/>requesting_department_id"]
    end
    subgraph PHA["pharmacy"]
        RX["PRESCRIPTION<br/>department_id"]
    end
    subgraph BIL["billing"]
        FEE["FEE<br/>department_id"]
    end
    subgraph REP["report"]
        DVR["DAILY_VISIT_REPORT<br/>department_id (NULL=hospital-wide)"]
        MRR["MONTHLY_REVENUE_REPORT"]
        DST["DRUG_STATISTIC"]
    end
    DEPT -->|FK| STAFF
    STAFF -->|FK| ACCOUNT
    DEPT -.->|department_id| APPT & MRECORD
    DEPT -.->|requesting_department_id| LTEST
    DEPT -.->|department_id| RX & FEE & DVR & MRR & DST
