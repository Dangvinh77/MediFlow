flowchart LR
    subgraph CLI["clinical"]
        MRECORD["MEDICAL_RECORD"]
    end
    subgraph PHA["pharmacy"]
        DRUG["DRUG<br/>stock_quantity"]
        RX["PRESCRIPTION<br/>total_amount"]
        RXLINE["PRESCRIPTION_LINE<br/>unit_price (snapshot)"]
        DSLIP["DISPENSE_SLIP<br/>PENDING → DISPENSED / FAILED"]
        RX -->|FK| RXLINE
        DRUG -->|FK| RXLINE
        RX -->|FK UNIQUE| DSLIP
    end
    subgraph BIL["billing"]
        INV["INVOICE<br/>saga_status"]
        FEE["FEE<br/>fee_type=DRUG"]
    end
    subgraph LAB["lab"]
        LTEST["LAB_TEST<br/>is_paid"]
    end
    subgraph REP["report"]
        DVR["DAILY_VISIT_REPORT"]
        MRR["MONTHLY_REVENUE_REPORT"]
        DST["DRUG_STATISTIC"]
    end
    subgraph NOT["notification"]
        NOTIF["NOTIFICATION"]
    end
    MRECORD -.->|record_id| RX
    RX ==>|prescription.created| INV
    INV -->|invoice_id FK| FEE
    INV ==>|payment.completed| DSLIP
    INV ==>|payment.completed| LTEST
    DSLIP ==>|prescription.filled| INV
    DSLIP ==>|prescription.filled| DST
    INV ==>|payment.completed| MRR
    INV ==>|payment.failed| DVR
    DSLIP -.->|prescription.dispense.failed| INV
    DSLIP ==>|prescription.filled| NOTIF
    INV ==>|payment.completed| NOTIF
