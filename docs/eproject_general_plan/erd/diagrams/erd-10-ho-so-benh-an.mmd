flowchart LR
    subgraph CLI["clinical"]
        MRECORD["MEDICAL_RECORD<br/>record_id"]
        DIAG["DIAGNOSIS<br/>icd_code"]
        ATTACH["RECORD_ATTACHMENT<br/>(type, ref_id, summary)"]
    end
    subgraph LAB["lab"]
        LTEST["LAB_TEST"]
        LRESULT["LAB_RESULT<br/>indicator / value"]
    end
    subgraph PHA["pharmacy"]
        RX["PRESCRIPTION"]
        RXLINE["PRESCRIPTION_LINE<br/>drug_name / quantity / dosage"]
        DSLIP["DISPENSE_SLIP<br/>dispense status"]
    end
    subgraph BIL["billing"]
        FEE["FEE<br/>EXAM / LAB / DRUG"]
        INV["INVOICE<br/>saga_status / paid_at"]
    end
    MRECORD -->|FK| DIAG
    MRECORD -->|FK| ATTACH
    MRECORD -.->|record_id| LTEST
    LTEST -->|FK| LRESULT
    MRECORD -.->|record_id| RX
    RX -->|FK| RXLINE
    RX -->|FK UNIQUE| DSLIP
    MRECORD -.->|record_id| FEE
    FEE -->|invoice_id FK| INV
    LTEST -.->|lab.result.created| ATTACH
    RX -.->|prescription.filled| ATTACH
