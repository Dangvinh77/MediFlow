flowchart LR
    subgraph ORG["organization"]
        KHOA["KHOA"]
        NV["NHAN_VIEN"]
        TK["TAI_KHOAN"]
    end
    subgraph PAT["patient"]
        BN["BENH_NHAN"]
    end
    subgraph CLI["clinical"]
        LH["LICH_HEN"]
        HS["HO_SO_BA"]
        CD["CHUAN_DOAN"]
        KQDK["KET_QUA_DINH_KEM"]
    end
    subgraph LAB["lab"]
        XN["XET_NGHIEM"]
        KQXN["KET_QUA_XN"]
    end
    subgraph PHA["pharmacy"]
        DR["DRUG"]
        PR["PRESCRIPTION"]
        PRL["PRESCRIPTION_LINE"]
        DS["DISPENSE_SLIP"]
    end
    subgraph BIL["billing"]
        FEE["FEE"]
        INV["INVOICE"]
    end
