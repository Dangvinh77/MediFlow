flowchart LR
    subgraph PHA["pharmacy"]
        DRUG["DRUG<br/>stock_quantity / expiry_date / low_stock_threshold"]
        RXLINE["PRESCRIPTION_LINE<br/>unit_price (snapshot)"]
        DSLIP["DISPENSE_SLIP<br/>deduct stock when DISPENSED"]
        RX["PRESCRIPTION"]
    end
    subgraph BIL["billing"]
        INV["INVOICE<br/>must be PAID before dispense"]
        FEE["FEE<br/>fee_type=DRUG"]
    end
    subgraph REP["report"]
        DST["DRUG_STATISTIC<br/>dispensed_quantity"]
    end
    subgraph NOT["notification"]
        NOTIF["NOTIFICATION<br/>low stock alert"]
    end
    RX -->|FK| RXLINE
    DRUG -->|FK| RXLINE
    RX -->|FK UNIQUE| DSLIP
    RX -.->|prescription.created| FEE
    INV ==>|payment.completed| DSLIP
    DSLIP ==>|prescription.filled| DST
    DRUG ==>|stock.low| NOTIF
