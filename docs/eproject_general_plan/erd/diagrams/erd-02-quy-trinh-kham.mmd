flowchart LR
    subgraph ORG["organization"]
        DEPT["DEPARTMENT"]
        STAFF["STAFF (doctor)"]
    end
    subgraph PAT["patient"]
        PATIENT["PATIENT"]
    end
    subgraph CLI["clinical"]
        APPT["APPOINTMENT<br/>PENDING → ARRIVED / CANCELLED"]
        MRECORD["MEDICAL_RECORD<br/>examination_date"]
        DIAG["DIAGNOSIS<br/>icd_code"]
    end
    subgraph LAB["lab"]
        LTEST["LAB_TEST<br/>status"]
        LRESULT["LAB_RESULT<br/>indicator / value"]
    end
    subgraph PHA["pharmacy"]
        RX["PRESCRIPTION"]
        RXLINE["PRESCRIPTION_LINE"]
    end
    DEPT -->|FK| STAFF
    PATIENT -.->|patient_id| APPT
    STAFF -.->|doctor_id| APPT
    APPT -->|FK| MRECORD
    MRECORD -->|FK| DIAG
    MRECORD -.->|record_id| LTEST
    LTEST -->|FK| LRESULT
    MRECORD -.->|record_id| RX
    RX -->|FK| RXLINE
    LRESULT -.->|lab.result.created| MRECORD
    RX -.->|prescription.filled| MRECORD
