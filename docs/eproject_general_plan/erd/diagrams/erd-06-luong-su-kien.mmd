flowchart LR
    subgraph ORG["organization"]
        STAFF["STAFF"]
    end
    subgraph PAT["patient"]
        PATIENT["PATIENT"]
    end
    subgraph CLI["clinical"]
        MRECORD["MEDICAL_RECORD"]
        APPT["APPOINTMENT"]
    end
    subgraph LAB["lab"]
        LTEST["LAB_TEST"]
    end
    subgraph PHA["pharmacy"]
        RX["PRESCRIPTION"]
        DSLIP["DISPENSE_SLIP"]
        DRUG["DRUG"]
    end
    subgraph BIL["billing"]
        INV["INVOICE"]
        FEE["FEE"]
    end
    subgraph NOT["notification"]
        NOTIF["NOTIFICATION"]
    end
    subgraph REP["report"]
        R["DAILY_VISIT_REPORT + MONTHLY_REVENUE_REPORT + DRUG_STATISTIC"]
    end

    PATIENT ==>|patient.created| NOTIF
    APPT ==>|appointment.created| NOTIF
    MRECORD ==>|medicalrecord.created| LTEST & FEE & R
    LTEST ==>|lab.result.created| MRECORD & FEE & NOTIF & R
    RX ==>|prescription.created| INV
    RX ==>|prescription.filled| MRECORD & INV & NOTIF & R & DRUG
    DSLIP ==>|prescription.dispense.failed| INV & NOTIF
    INV ==>|payment.completed| DSLIP & LTEST & NOTIF & R
    INV ==>|payment.failed| NOTIF & R
    APPT ==>|appointment.status.changed| FEE
    STAFF ==>|staff.department.changed| R
    DRUG ==>|stock.low| NOTIF
