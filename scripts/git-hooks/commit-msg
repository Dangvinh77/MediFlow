#!/bin/sh
#
# COMMIT-MSG HOOK — MediFlow
# Chặn commit không thuộc bốn contributor hoặc có trailer gán quyền tác giả cho AI.

COMMIT_MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

node "$REPO_ROOT/scripts/verify-commit-policy.js" \
  --current-author \
  --message-file "$COMMIT_MSG_FILE"
