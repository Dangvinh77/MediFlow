#!/bin/sh
#
# PREPARE-COMMIT-MSG HOOK — MediFlow
# Xoá mọi trailer gán quyền tác giả cho AI khỏi commit message.
# Commit chỉ được mang một trong bốn danh tính tại scripts/allowed-contributors.json.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"
SHA1="$3"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Dùng Node thay vì sed để chạy nhất quán trên Windows, macOS và Linux.
if [ -f "$COMMIT_MSG_FILE" ]; then
  node "$REPO_ROOT/scripts/verify-commit-policy.js" --sanitize-message "$COMMIT_MSG_FILE"
fi
