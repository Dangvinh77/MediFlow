# Copy to .env.local for local overrides (.env.local is gitignored).
# Origin of the API gateway. Next proxies /api/* here (see next.config.ts).
# Defaults to http://localhost:8080 if unset, so you usually don't need this locally.
GATEWAY_URL=http://localhost:8080

# Server-only UI gate; leave false until matching Clinical/Lab/Billing modes are accepted.
# Restart the frontend after changing. This does not enable any backend feature flag.
MEDIFLOW_OUTPATIENT_UI_ENABLED=false
