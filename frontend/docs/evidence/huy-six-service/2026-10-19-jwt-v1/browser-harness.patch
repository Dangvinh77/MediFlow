+        assertThat(source.path("recordId")).isEqualTo(record.path("recordId"));
+        assertThat(source.path("careEpisodeType").asText()).isEqualTo("OUTPATIENT_VISIT");
+        JsonNode drug = data(post(gateway, "/api/v1/pharmacy/drugs", admin,
