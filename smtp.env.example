# SMTP configuration template. Safe to commit; never put real credentials here.
# Copy to smtp.local.env; start-backend.bat loads it automatically.
# For direct IDE/Java startup, dot-source scripts/load-smtp-local.ps1 first.
# Spring Boot itself does not read this file.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-sender@gmail.com
SPRING_MAIL_PASSWORD=replace-with-google-app-password
SPRING_MAIL_DEFAULT_ENCODING=UTF-8
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=10000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=10000

# Account email and recovery settings.
MEDIFLOW_MAIL_FROM=your-sender@gmail.com
MEDIFLOW_MAIL_FROM_NAME=MediFlow
MEDIFLOW_PUBLIC_WEB_URL=http://localhost:3000
# Generate a base64-encoded 32-byte key; keep it stable for pending email retries.
MEDIFLOW_SECURITY_MAIL_KEY=replace-with-base64-encoded-32-byte-key
# Enable only in a local/demo environment; seed mailboxes expose demo credentials.
MEDIFLOW_DEMO_MAILBOX_ENABLED=false
